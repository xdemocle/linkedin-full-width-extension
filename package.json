{
  "name": "linkedin-full-width-extension",
  "version": "1.2.0",
  "description": "LinkedIn Full Width",
  "repository": "https://github.com/xdemocle/linkedin-full-width-extension.git",
  "author": {
    "name": "xdemocle",
    "email": "xdemocle@gmail.com",
    "url": "https://rocco.me"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "dev:opera": "wxt -b opera",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:opera": "wxt build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:opera": "wxt zip -b opera",
    "compile": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.20.27"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}